module MathOps {
    int Add(int left, int right) {
        return left + right
    }
}

void NoParameters {
    return
}

void UnknownParameters() {
    return
}

int Main(void) {
    var new result = MathOps::Add(20, 22)
    UnknownParameters(1, 2)
    NoParameters()
    if result == 42 {
        return result - 42
    } else {
        return 1
    }
}
