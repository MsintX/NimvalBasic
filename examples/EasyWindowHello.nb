include <EasyWindow>

void Window(void) {
    var new (auto)App = EasyWindow.Window
    App.Title = "Hello, EasyWindow"
    App.Geometry("520x320")
}

module Controls {
    void Label(void) {
        var new (auto)Greeting = EasyWindow.Label
    }

    void Button(void) {
        var new (auto)Submit = EasyWindow.Button
    }
}
