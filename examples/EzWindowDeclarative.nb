const <EzWindow>
void Window :
    var new (auto)App = EzWindow.Window
    App.Title = "Declarative controls"
    App.Geometry("640x480")
    App.Style = "styles/app.css"
end
module Controls :
    void Label :
        var new (auto)Status = EzWindow.Label
        loction(%, 5, 90, 5, 5)
        setText(Status, "Ready")
    end
    void Button :
        var new (auto)RunButton = EzWindow.Button
        loction(%, 15, 75, 5, 5)
        setText(RunButton, "Run")
    end
    void Entry :
        var new (auto)NameInput = EzWindow.Entry
        loction(%, 25, 65, 5, 5)
        size(px, 360, 36)
    end
    void PasswordEntry :
        var new (auto)PasswordInput = EzWindow.PasswordEntry
        loction(px, 110, 20, 5, 5)
        size(px, 360, 36)
    end
end
