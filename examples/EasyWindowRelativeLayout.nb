include <EasyWindow>

/*
 * EasyWindow responsive layout example.
 * Percentage values are relative to the window client area.
 */
var new root = window("Responsive Nimval UI", 900, 600)
var new titleLabel = label(root, "Responsive interface")
var new nameInput = entry(root, "Enter your name")
var new sayButton = button(root, "Say hello")
var new messageArea = textBox(root, "This control scales with the window.")
var new enabledOption = checkBox(root, "Enable friendly greeting")

setRelativeBounds(titleLabel, 5, 5, 90, 8)
setRelativeBounds(nameInput, 5, 17, 65, 10)
setRelativeBounds(sayButton, 73, 17, 22, 10)
setRelativeBounds(messageArea, 5, 32, 90, 48)
setRelativeBounds(enabledOption, 5, 85, 90, 8)

void greet(void) {
    if getText(nameInput) == "" {
        setText(titleLabel, "Please enter your name.")
    } else {
        if getChecked(enabledOption) {
            setText(titleLabel, "Hello, " + getText(nameInput) + "! Have a great day.")
        } else {
            setText(titleLabel, "Hello, " + getText(nameInput) + "!")
        }
    }
    return
}

int Main(void) {
    onClick(sayButton, "greet")
    mainloop()
    return 0
}
